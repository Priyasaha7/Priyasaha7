# Copy this file to .env and fill in real values. .env is gitignored.
#
# GitHub removed password authentication for Git in August 2021.
# Your account password will NOT work here -- you need a token.
#
# Create one at: https://github.com/settings/tokens
#   - "Fine-grained tokens" -> Generate new token
#   - Repository access: only the repo you push to
#   - Permissions: Contents = Read and write
#   - Set an expiry (90 days is reasonable; you will need to renew)

GITHUB_USERNAME=Priyasaha7
GITHUB_TOKEN=github_pat_replace_me

# Used for the commit author. The noreply form keeps your real address private.
GIT_AUTHOR_NAME=Priyasaha7
GIT_AUTHOR_EMAIL=148933801+Priyasaha7@users.noreply.github.com
